# Puerto HTTP+WS del backend
PORT=3210
# URL del SFU LiveKit que usarán LOS CLIENTES (pública si juegan por internet)
LIVEKIT_URL=ws://localhost:7880
# Deben coincidir con livekit.yaml
LIVEKIT_KEY=devkey
LIVEKIT_SECRET=devsecret-devsecret-devsecret-32
# OPCIONAL: auto-updates desde GitHub Releases (repo PÚBLICO usuario/repo).
# Si está definido y no hay manifiesto local, /api/updates/:platform sirve
# la última release de GitHub. Publicar = empujar un tag vX.Y.Z (ver CI).
GITHUB_REPO=servo98/chatAyPapol
